---
import Layout from '../layouts/Layout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';

const schema = JSON.stringify({
  "@context": "https://schema.org",
  "@type": "Plumber",
  "name": "Dupont Plomberie",
  "foundingDate": "2008",
  "founder": { "@type": "Person", "name": "Jean-Paul Dupont" },
  "numberOfEmployees": { "@type": "QuantitativeValue", "value": 8 },
  "address": { "@type": "PostalAddress", "addressLocality": "Lyon", "postalCode": "69000", "addressCountry": "FR" }
});
---

<Layout
  title="À propos | Dupont Plomberie Lyon"
  description="Découvrez Dupont Plomberie : 16 ans d'expérience à Lyon, plombiers certifiés RGE, assurance décennale, plus de 1 200 clients satisfaits."
  schema={schema}
>
  <Header />
  <main>

    <div class="page-hero">
      <div class="container">
        <nav class="breadcrumb" aria-label="Fil d'Ariane">
          <a href="/">Accueil</a>
          <span aria-hidden="true">›</span>
          <span>À propos</span>
        </nav>
        <h1>À propos de Dupont Plomberie</h1>
        <p>Votre plombier de confiance à Lyon depuis 2008</p>
      </div>
    </div>

    <!-- Histoire -->
    <section class="section-white">
      <div class="container">
        <div class="about-grid">
          <div class="about-image">
            <img
              src="https://images.unsplash.com/photo-1504328345606-18bbc8c9d7d1?w=800&q=80"
              alt="Équipe Dupont Plomberie au travail"
              width="560"
              height="420"
              loading="lazy"
            />
          </div>
          <div class="about-text">
            <h2>Notre histoire</h2>
            <p>
              Fondée en 2008 par Jean-Paul Dupont, plombier de métier depuis 20 ans, Dupont Plomberie est née d'une conviction simple : les Lyonnais méritent un plombier fiable, transparent sur ses tarifs et disponible quand ils en ont vraiment besoin.
            </p>
            <p>
              Depuis nos débuts avec une seule camionnette et deux techniciens, nous avons grandi pour constituer aujourd'hui une équipe de 8 plombiers qualifiés, couvrant l'ensemble des 9 arrondissements de Lyon 7 jours sur 7, 24 heures sur 24.
            </p>
            <p>
              Notre développement est fondé sur la confiance de nos clients, la qualité de nos travaux et notre réactivité face aux urgences. Plus de 1 200 familles et entreprises lyonnaises nous font confiance chaque année.
            </p>
            <a href="/contact" class="btn btn-primary mt-4">Nous contacter</a>
          </div>
        </div>
      </div>
    </section>

    <!-- Chiffres clés -->
    <section class="section-light">
      <div class="container">
        <div class="section-header">
          <h2>Dupont Plomberie en chiffres</h2>
          <p>16 ans d'expérience au service des Lyonnais</p>
        </div>
        <div class="stats-grid">
          <div class="stat-card">
            <p class="stat-number">16</p>
            <p class="stat-label">Années d'expérience</p>
          </div>
          <div class="stat-card">
            <p class="stat-number">1 200+</p>
            <p class="stat-label">Clients par an</p>
          </div>
          <div class="stat-card">
            <p class="stat-number">4,8/5</p>
            <p class="stat-label">Note moyenne clients</p>
          </div>
          <div class="stat-card">
            <p class="stat-number">8</p>
            <p class="stat-label">Techniciens qualifiés</p>
          </div>
        </div>
      </div>
    </section>

    <!-- Certifications -->
    <section class="section-white">
      <div class="container">
        <div class="section-header">
          <h2>Nos certifications</h2>
          <p>Des garanties concrètes pour votre tranquillité d'esprit</p>
        </div>
        <div class="certif-grid">
          <div class="certif-card">
            <svg width="32" height="32" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
              <path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"/>
              <polyline points="9 12 11 14 15 10"/>
            </svg>
            <h3>Certifié RGE</h3>
            <p>Reconnu Garant de l'Environnement pour les travaux éligibles aux aides de l'État</p>
          </div>
          <div class="certif-card">
            <svg width="32" height="32" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
              <rect x="3" y="3" width="18" height="18" rx="2" ry="2"/>
              <polyline points="9 12 11 14 15 10"/>
            </svg>
            <h3>Assurance décennale</h3>
            <p>Garantie de 10 ans sur tous nos travaux d'installation et de rénovation</p>
          </div>
          <div class="certif-card">
            <svg width="32" height="32" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
              <circle cx="12" cy="8" r="6"/>
              <path d="M15.477 12.89L17 22l-5-3-5 3 1.523-9.11"/>
            </svg>
            <h3>Qualibat</h3>
            <p>Qualification professionnelle attestant de notre compétence et de la qualité de nos travaux</p>
          </div>
          <div class="certif-card">
            <svg width="32" height="32" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
              <path d="M3 9l9-7 9 7v11a2 2 0 01-2 2H5a2 2 0 01-2-2z"/>
              <polyline points="9 22 9 12 15 12 15 22"/>
            </svg>
            <h3>Pro de la Réno'</h3>
            <p>Label national pour les professionnels de la rénovation énergétique</p>
          </div>
          <div class="certif-card">
            <svg width="32" height="32" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
              <path d="M21 10c0 7-9 13-9 13s-9-6-9-13a9 9 0 0118 0z"/>
              <circle cx="12" cy="10" r="3"/>
            </svg>
            <h3>Couverture Lyon</h3>
            <p>Intervention garantie dans les 9 arrondissements de Lyon en moins de 2 heures</p>
          </div>
          <div class="certif-card">
            <svg width="32" height="32" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
              <circle cx="12" cy="12" r="10"/>
              <polyline points="12 6 12 12 16 14"/>
            </svg>
            <h3>Service 24h/7j</h3>
            <p>Équipe d'astreinte permanente pour les urgences plomberie à toute heure</p>
          </div>
        </div>
      </div>
    </section>

    <!-- Valeurs -->
    <section class="section-light">
      <div class="container">
        <div class="section-header">
          <h2>Nos valeurs</h2>
          <p>Ce qui nous guide au quotidien dans notre métier</p>
        </div>
        <div class="values-grid">
          <div class="value-card">
            <h3>Transparence tarifaire</h3>
            <p>Le devis vous est remis avant toute intervention. Le prix annoncé est le prix facturé, sans surprise ni frais cachés. Nous n'avons rien à cacher.</p>
          </div>
          <div class="value-card">
            <h3>Réactivité</h3>
            <p>Nous savons qu'une urgence plomberie ne peut pas attendre. C'est pourquoi nous maintenons une équipe d'astreinte disponible 24h/24, même les dimanches et jours fériés.</p>
          </div>
          <div class="value-card">
            <h3>Qualité du travail</h3>
            <p>Chaque intervention est réalisée avec des matériaux de qualité et dans le respect des normes en vigueur. Nous ne faisons pas de travail bâclé : notre réputation en dépend.</p>
          </div>
          <div class="value-card">
            <h3>Respect de votre espace</h3>
            <p>Nos techniciens protègent vos sols et mobiliers avant d'intervenir, et laissent les lieux propres après chaque chantier. Votre domicile est traité avec le plus grand soin.</p>
          </div>
        </div>
      </div>
    </section>

    <!-- CTA -->
    <section class="section-navy cta-section">
      <div class="container">
        <h2>Faites confiance à votre plombier lyonnais</h2>
        <p class="cta-sub">16 ans d'expérience, des centaines de clients satisfaits. Contactez-nous pour votre prochain projet ou urgence.</p>
        <div class="cta-buttons">
          <a href="tel:0472000000" class="btn btn-white btn-lg">
            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
              <path d="M22 16.92v3a2 2 0 01-2.18 2 19.79 19.79 0 01-8.63-3.07A19.5 19.5 0 013.4 10.8a19.79 19.79 0 01-3.07-8.67A2 2 0 012.31 0h3a2 2 0 012 1.72c.127.96.361 1.903.7 2.81a2 2 0 01-.45 2.11L6.91 7.91a16 16 0 006.13 6.13l1.27-.76a2 2 0 012.11-.45c.907.339 1.85.573 2.81.7A2 2 0 0122 16.92z"/>
            </svg>
            04 72 00 00 00
          </a>
          <a href="/contact" class="btn btn-outline-white btn-lg">Demander un devis gratuit</a>
        </div>
      </div>
    </section>

  </main>
  <Footer />
</Layout>
