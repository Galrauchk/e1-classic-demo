---
import LegalLinks from './LegalLinks.astro';
---

<footer class="footer">
  <div class="footer-main">
    <div class="container">
      <div class="footer-grid">

        <!-- Col 1 : Identité -->
        <div class="footer-col">
          <div class="footer-logo">
            <svg width="20" height="20" viewBox="0 0 20 20" fill="none" xmlns="http://www.w3.org/2000/svg" aria-hidden="true">
              <circle cx="10" cy="10" r="10" fill="rgba(255,255,255,0.15)"/>
              <path d="M10 4v6l4 2" stroke="#fff" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/>
              <circle cx="10" cy="10" r="2" fill="#fff"/>
            </svg>
            Dupont Plomberie
          </div>
          <p class="footer-desc">
            Plombier professionnel à Lyon depuis 2008. Intervention rapide pour tous vos besoins en plomberie, dépannage et installation sanitaire dans les 9 arrondissements.
          </p>
          <span class="footer-available">
            <svg width="8" height="8" viewBox="0 0 8 8" fill="none" aria-hidden="true">
              <circle cx="4" cy="4" r="4" fill="#22c55e"/>
            </svg>
            Disponible 24h/7j
          </span>
        </div>

        <!-- Col 2 : Services -->
        <div class="footer-col">
          <h4>Nos services</h4>
          <ul class="footer-links">
            <li><a href="/services#depannage">Dépannage urgent</a></li>
            <li><a href="/services#installation">Installation sanitaire</a></li>
            <li><a href="/services#detection">Détection de fuite</a></li>
            <li><a href="/services#debouchage">Débouchage canalisation</a></li>
            <li><a href="/services#chauffe-eau">Remplacement chauffe-eau</a></li>
            <li><a href="/services#renovation">Rénovation salle de bain</a></li>
          </ul>
        </div>

        <!-- Col 3 : Contact -->
        <div class="footer-col">
          <h4>Contact</h4>
          <div class="footer-contact-item">
            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
              <path d="M22 16.92v3a2 2 0 01-2.18 2 19.79 19.79 0 01-8.63-3.07A19.5 19.5 0 013.4 10.8a19.79 19.79 0 01-3.07-8.67A2 2 0 012.31 0h3a2 2 0 012 1.72c.127.96.361 1.903.7 2.81a2 2 0 01-.45 2.11L6.91 7.91a16 16 0 006.13 6.13l1.27-.76a2 2 0 012.11-.45c.907.339 1.85.573 2.81.7A2 2 0 0122 16.92z"/>
            </svg>
            <a href="tel:0472000000">04 72 00 00 00</a>
          </div>
          <div class="footer-contact-item">
            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
              <path d="M4 4h16c1.1 0 2 .9 2 2v12c0 1.1-.9 2-2 2H4c-1.1 0-2-.9-2-2V6c0-1.1.9-2 2-2z"/>
              <polyline points="22,6 12,13 2,6"/>
            </svg>
            <span>contact@dupont-plomberie.fr</span>
          </div>
          <div class="footer-contact-item">
            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
              <path d="M21 10c0 7-9 13-9 13s-9-6-9-13a9 9 0 0118 0z"/>
              <circle cx="12" cy="10" r="3"/>
            </svg>
            <span>Lyon 69000 — Tous arrondissements</span>
          </div>
          <div class="footer-contact-item">
            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
              <circle cx="12" cy="12" r="10"/>
              <polyline points="12 6 12 12 16 14"/>
            </svg>
            <span>Lun–Dim : 24h/24 — 7j/7</span>
          </div>
        </div>

      </div>
    </div>
  </div>

  <div class="footer-divider"></div>

  <div class="footer-bottom">
    <div class="container">
      <div class="footer-bottom-inner">
        <p class="footer-copyright">© 2024 Dupont Plomberie — Tous droits réservés</p>
        <nav class="footer-legal-links" aria-label="Liens légaux">
          <a href="/mentions-legales">Mentions légales</a>
          <a href="/mentions-legales#cgv">CGV</a>
          <a href="/contact">Devis gratuit</a>
        </nav>
      </div>
      <p class="footer-watermark">
        Site réalisé par <a href="https://webtrafic.fr" target="_blank" rel="noopener noreferrer">WebTrafic</a> — Agence SEO Montpellier
      </p>
      <LegalLinks includeMentions={false} />
    </div>
  </div>
</footer>
