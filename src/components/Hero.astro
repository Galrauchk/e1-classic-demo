<section class="hero" aria-label="Bannière principale">
  <div class="hero-overlay" aria-hidden="true"></div>
  <div class="container">
    <div class="hero-content">
      <div class="hero-badge">
        <svg width="12" height="12" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M13 2L3 14h9l-1 8 10-12h-9l1-8z"/></svg>
        Intervention en 2h sur Lyon
      </div>

      <h1>Plombier Lyon — Dépannage Rapide 24h/7j</h1>

      <p class="hero-subtitle">
        Spécialiste plomberie et dépannage urgent dans les 9 arrondissements de Lyon. Devis gratuit et intervention garantie.
      </p>

      <div class="hero-buttons">
        <a href="tel:0472000000" class="btn btn-white btn-lg">
          <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <path d="M22 16.92v3a2 2 0 01-2.18 2 19.79 19.79 0 01-8.63-3.07A19.5 19.5 0 013.4 10.8a19.79 19.79 0 01-3.07-8.67A2 2 0 012.31 0h3a2 2 0 012 1.72c.127.96.361 1.903.7 2.81a2 2 0 01-.45 2.11L6.91 7.91a16 16 0 006.13 6.13l1.27-.76a2 2 0 012.11-.45c.907.339 1.85.573 2.81.7A2 2 0 0122 16.92z"/>
          </svg>
          04 72 00 00 00
        </a>
        <a href="/contact" class="btn btn-outline-white btn-lg">
          Devis gratuit
        </a>
      </div>

      <div class="hero-trust" role="list">
        <span class="trust-badge" role="listitem">
          <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><polyline points="20 6 9 17 4 12"/></svg>
          Certifié RGE
        </span>
        <span class="trust-badge" role="listitem">
          <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><polyline points="20 6 9 17 4 12"/></svg>
          Assurance décennale
        </span>
        <span class="trust-badge" role="listitem">
          <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><polyline points="20 6 9 17 4 12"/></svg>
          Devis gratuit
        </span>
      </div>
    </div>
  </div>
</section>
